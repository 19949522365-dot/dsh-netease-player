{
  "name": "dsh-netease-player",
  "version": "0.5.0",
  "type": "module",
  "description": "网易云音乐播放器 + B 站音源：DSH 窗口底部常驻播放条，搜索、播放、歌词、扫码登录都在页面里，不用另开窗口。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "netease",
    "netease-cloud-music",
    "bilibili",
    "music",
    "player"
  ],
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/19949522365-dot/dsh-netease-player.git"
  },
  "homepage": "https://github.com/19949522365-dot/dsh-netease-player#readme",
  "bugs": {
    "url": "https://github.com/19949522365-dot/dsh-netease-player/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT"
}
